# Copy to secrets.toml and provide real values privately. Never commit secrets.toml.
GEMINI_API_KEY = ""
MARKET_API_KEY = ""
# Optional audio-capable model; verify availability for your account.
GEMINI_TRANSCRIPTION_MODEL = "gemini-3.1-flash-lite"
# Use an operator-managed persistent volume for durable account data.
ROCOLE_DB_PATH = "/workspace/rocole-data/rocole.sqlite"
FEEDBACK_DB_PATH = "/workspace/rocole-data/feedback.sqlite"
# Set true only after independently verifying storage persistence and backups.
FEEDBACK_DB_PERSISTENT = "false"
SMTP_HOST = ""
SMTP_PORT = "587"
SMTP_USER = ""
SMTP_PASSWORD = ""
FEEDBACK_TO_EMAIL = ""

# Remove this block until your OIDC provider is configured.
[auth]
redirect_uri = "https://YOUR-APP-HOST/oauth2callback"
cookie_secret = "REPLACE-WITH-A-LONG-RANDOM-SECRET"
client_id = "YOUR-OIDC-CLIENT-ID"
client_secret = "YOUR-OIDC-CLIENT-SECRET"
server_metadata_url = "https://YOUR-PROVIDER/.well-known/openid-configuration"
